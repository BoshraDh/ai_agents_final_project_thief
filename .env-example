# Copy this file to .env and fill in real values locally. Never commit .env.
# Only needed once the reporting stage (Gmail API) is wired up — see docs/PRD_reporting_shell.md.

# Path to the Gmail OAuth2 client-secret file downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=credentials.json

# Path to the auto-generated OAuth token (created on first run, not committed).
GMAIL_TOKEN_PATH=token.json

# Optional: only needed if you opt into the claude_api trash-talk provider.
ANTHROPIC_API_KEY=
